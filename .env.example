# NextAuth Configuration
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=https://your-app.vercel.app # Or http://localhost:3000 for local dev

# Turso (libSQL) Database Configuration
TURSO_DATABASE_URL=libsql://your-database-name-your-username.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Optional: Local SQLite path fallback for local dev if Turso is not set
DATABASE_LOCAL_PATH=./data/expense-tracker.db
